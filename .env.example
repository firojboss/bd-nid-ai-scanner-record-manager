# =============================================================================
# BD NID AI Scanner — Environment Variables
# Copy to .env for local dev, or set in Vercel → Project → Settings → Environment Variables
# =============================================================================

# Gemini AI OCR (required for scanning)
GEMINI_API_KEY=

# Supabase — server-side (required on Vercel for persistent storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — optional client-side (only if using direct browser access later)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local / self-hosted only (Vercel sets these automatically)
# NODE_ENV=production
# PORT=3000
